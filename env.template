# Copy this file to .env and fill in your values.
#   cp env.template .env

# ── LLM Provider ──────────────────────────────────────────────────────────────
# 'anthropic' (default) uses ANTHROPIC_API_KEY directly.
# 'bedrock' uses AWS credentials (add @anthropic-ai/bedrock-sdk to server deps).
ANTHROPIC_PROVIDER=anthropic

# Required when ANTHROPIC_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required when ANTHROPIC_PROVIDER=bedrock
# AWS_REGION=eu-west-1
# AWS_PROFILE=your-sso-profile
# BEDROCK_MODEL_ID=<application-inference-profile-ARN>

# ── Integrations ──────────────────────────────────────────────────────────────
FIGMA_TOKEN=

# Absolute path to the local checkout of the artifacts git repo
ARTIFACTS_REPO_PATH=/path/to/your/artifacts-repo

# Azure DevOps PAT (Code: Read & Write scope) — required for PR creation
AZURE_DEVOPS_PAT=

# ── Database (docker-compose default: docker compose up -d) ──────────────────
DATABASE_URL=postgresql://orrery:orrery@localhost:5432/orrery

# ── Redis (docker-compose default) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Install strategy ─────────────────────────────────────────────────────────
# 'host' (default) runs npm on the host with platform-override flags so
# linux-musl native deps are downloaded via the proven host network path.
# Set to 'container' once an internal registry mirror is available.
# INSTALL_STRATEGY=host

# ── Container image ───────────────────────────────────────────────────────────
# On corporate networks where Docker Hub is blocked, point at an internal mirror.
# AGENT_CONTAINER_IMAGE=<internal-mirror>/node:20-alpine
#
# Emergency host-exec bypass (local dev only — explicit double opt-in required):
# AGENT_CONTAINER_IMAGE=none
# AGENT_UNSAFE_HOST_EXEC=true

# ── Spend guard ───────────────────────────────────────────────────────────────
# Park a task and open a human-review gate when cumulative agent turns reach this limit.
SPEND_GUARD_MAX_TURNS=150

# ── Brand config (all optional — defaults shown) ─────────────────────────────
# BOT_GIT_NAME=Orrery
# BOT_GIT_EMAIL=orrery-bot@example.com
# CONTAINER_PREFIX=orrery-agent
# VITE_PRODUCT_NAME=Orrery        # UI header wordmark and page title; fallback is Orrery
# VITE_TENANT_LINE=AGENT SOLAR SYSTEM  # subtitle line in UI header; set empty to hide
