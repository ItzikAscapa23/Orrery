{
  "name": "@orrery/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WORKER_CODE_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo unknown) tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.0",
    "@anthropic-ai/sdk": "^0.26.0",
    "@fastify/multipart": "^8.3.0",
    "@orrery/shared": "*",
    "@prisma/client": "^4.16.2",
    "bullmq": "^5.81.2",
    "dotenv": "^16.6.1",
    "fastify": "^4.27.0",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.3.0",
    "zod": "^3.23.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "prisma": "^4.16.2",
    "tsx": "^4.23.1"
  }
}
