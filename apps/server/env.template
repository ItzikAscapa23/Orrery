# Server-local env overrides (SQLite mode only — not needed for Postgres).
# Copy to apps/server/.env if running in single-file SQLite mode.
ANTHROPIC_API_KEY=sk-ant-...
FIGMA_TOKEN=figd_...
ARTIFACTS_REPO_PATH=/path/to/artifacts-repo
DATABASE_PATH=./data/orrery.db
PORT=3001

# Spend guard: park a task when cumulative turns across all jobs reaches this limit (default: 150).
SPEND_GUARD_MAX_TURNS=150
